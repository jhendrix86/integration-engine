# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/integrations

# Redis
REDIS_URL=redis://localhost:6379

# Security
ENCRYPTION_KEY=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# Webhook
WEBHOOK_TIMEOUT=30

# Sync
SYNC_BATCH_SIZE=100
SYNC_RETRY_ATTEMPTS=3

# Application
DEBUG=false

# Integration
GLOBAL_STATE_MANAGER_URL=http://localhost:8035

# CORS — comma-separated allowed browser origins for cross-origin requests.
# Empty (default) denies all cross-origin. Set to the frontend origin(s) when
# a browser client exists, e.g. https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=
